---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { siteSettings } from "../config/site.mjs";
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const analytics = import.meta.env.PUBLICATION_MODE === "production" &&
  import.meta.env.ANALYTICS_DISABLED !== "true";
---
<!doctype html>
<html lang="ja"><head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2e9" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="燊然居士｜baidu.tokyo" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(`${base}/images/ogp.png`, Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="燊然居士。易を読み、変化を考える。"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(`${base}/images/ogp.png`, Astro.site)}
    />
    <meta
      name="twitter:image:alt"
      content="燊然居士。易を読み、変化を考える。"
    />

{analytics && <script is:inline type="module" src={`${base}/analytics.mjs`} data-measurement-id={siteSettings.measurementId} data-origin={siteSettings.productionOrigin}></script>}
</head><body>
<a class="skip-link" href="#main">本文へ移動</a>
<slot />
<Footer />
</body></html>
